# ── Election ────────────────────────────────────────────────────────────────
# Codes come from https://resultados.tse.jus.br/oficial/comum/config/ele-c.json ("pl" entries)
ELECTION_CYCLE=ele2026
# Pleito = every election held on one day: 3220 = 2026 1st round, 3221 = 2026 2nd round
PLEITO_CODE=3221
# Offices exported: 1 presidente, 3 governador, 5 senador, 6 dep. federal, 7 dep. estadual,
# 8 dep. distrital, 11 prefeito (supplementary elections share the pleito)
OFFICE_CODES=1,3
# Collectors in MODE=job: municipios (live totalization) and/or secoes (per-section BUs).
# secoes is off by default: under the TSE rate limit the whole country takes 8-11h.
COLLECTORS=municipios
# Comma-separated UFs; empty = every state plus "zz" (abroad)
STATES=

# ── Schedule (ISO 8601 with timezone; empty = start now / never stop) ──────
SCHEDULE_START=2026-10-25T17:00:00-03:00
SCHEDULE_END=2026-10-26T06:00:00-03:00

# ── Job ─────────────────────────────────────────────────────────────────────
# Job period and time budget: each job reads the section lists, fetches newly
# published BUs until the period is spent, then writes a CSV version. Minimum 30.
POLL_INTERVAL_SECONDS=60

# ── Output ──────────────────────────────────────────────────────────────────
# Path inside the container; docker-compose mounts OUTPUT_HOST_DIR here
OUTPUT_DIR=/data/output
OUTPUT_HOST_DIR=./output
# Two collectors, one folder each, both versioned the same way:
#   secoes/secoes_<tag>_0.csv ... + secoes_<tag>_current.csv          (per-section BUs)
#   municipios/municipios_<tag>_0.csv ... + municipios_<tag>_current.csv (live totalization)
# _current is always the newest and is not counted in MAX_CSV_VERSIONS (applied per folder).
OUTPUT_TAG=2t2026
MAX_CSV_VERSIONS=1000

# ── Database ────────────────────────────────────────────────────────────────
# Decoded BUs live here, so a restart or redeploy downloads nothing twice.
# docker-compose builds DATABASE_URL from this password; set DATABASE_URL yourself otherwise.
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5432

# ── HTTP ────────────────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000
REQUEST_TIMEOUT_MS=15000
# Per collector (secoes and municipios each use this many). On election day the TSE CDN
# answered 429 from 24 up; 16 was the highest value with zero throttling.
CONCURRENCY=16
LOG_LEVEL=info
