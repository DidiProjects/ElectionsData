# ── Election ────────────────────────────────────────────────────────────────
# Codes come from https://resultados.tse.jus.br/oficial/comum/config/ele-c.json
ELECTION_CYCLE=ele2026
# 6257/6258 = federal 1st/2nd round, 6259/6260 = state 1st/2nd round
ELECTION_CODE=6258
# 1 presidente, 3 governador, 5 senador, 6 dep. federal, 7 dep. estadual, 8 dep. distrital
OFFICE_CODES=1
# Comma-separated UFs; empty = every state (and "zz" = abroad)
STATES=

# ── Schedule (ISO 8601 with timezone; empty = start now / never stop) ──────
SCHEDULE_START=2026-10-25T16:30:00-03:00
SCHEDULE_END=2026-10-26T06:00:00-03:00

# ── Periods ─────────────────────────────────────────────────────────────────
# How often municipality results are checked (minimum 30; TSE caches for ~52s)
POLL_INTERVAL_SECONDS=60
# How often a CSV version is generated (skipped when nothing changed)
EXPORT_INTERVAL_SECONDS=120

# ── Output ──────────────────────────────────────────────────────────────────
# Path inside the container; docker-compose mounts OUTPUT_HOST_DIR here
OUTPUT_DIR=/data/output
OUTPUT_HOST_DIR=./output
MAX_CSV_VERSIONS=20

# ── HTTP ────────────────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=1000
REQUEST_TIMEOUT_MS=15000
CONCURRENCY=8
LOG_LEVEL=info
